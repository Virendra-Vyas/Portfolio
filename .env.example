# Copy to .env (never commit .env). Values are placeholders.

# --- web (/web) -------------------------------------------------------------
# Public URL of the contact API. Baked into the static build at build time.
NEXT_PUBLIC_CONTACT_API_URL=http://localhost:5113   # production: https://api.virendravyas.dev

# --- api (/api) -------------------------------------------------------------
# ASP.NET Core reads these as configuration (double underscore = section separator).
# Email provider and recipient are finalised in build step 8.
Contact__AllowedOrigin=http://localhost:3000
Contact__RecipientEmail=
Email__ApiKey=

# Production origin of the site, e.g. https://virendravyas.dev. Used for social preview URLs.
SITE_URL=
